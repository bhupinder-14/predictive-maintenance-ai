# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./predictive_maintenance.db

# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ── Model artifacts ─────────────────────────────────────
MODEL_DIR=models

# ── Milestone 4 drift monitoring ─────────────────────────
DRIFT_REFERENCE_PATH=data/reference/drift_reference_v1.json
DRIFT_KS_ALPHA=0.05
DRIFT_CATEGORICAL_TVD_THRESHOLD=0.10
DRIFT_MINIMUM_SAMPLE_SIZE=20

# ── Milestone 4 operational metrics ──────────────────────
METRICS_WINDOW_SECONDS=300
