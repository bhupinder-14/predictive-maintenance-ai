# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./predictive_maintenance.db
# Docker Compose uses this URL so the database remains on its named volume.
DOCKER_DATABASE_URL=sqlite:////var/lib/predictive-maintenance/predictive_maintenance.db

# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
# Bind the published API port to this host only. Override only behind a trusted network boundary.
HOST_IP=127.0.0.1
HOST_PORT=8000
LOG_LEVEL=INFO

# ── Model artifacts ─────────────────────────────────────
MODEL_DIR=models

# ── Milestone 4 drift monitoring ─────────────────────────
DRIFT_REFERENCE_PATH=data/reference/drift_reference_v1.json
DRIFT_KS_ALPHA=0.05
DRIFT_CATEGORICAL_TVD_THRESHOLD=0.10
DRIFT_MINIMUM_SAMPLE_SIZE=20

# ── Milestone 4 operational metrics ──────────────────────
METRICS_WINDOW_SECONDS=300

# Optional Docker named volume override (avoid deleting it unless data loss is intended).
DATABASE_VOLUME_NAME=predictive-maintenance-data
