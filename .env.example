# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./predictive_maintenance.db

# ── Application ──────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ── Model artifacts ─────────────────────────────────────
MODEL_DIR=models

# ── Monitoring ───────────────────────────────────────────
DRIFT_THRESHOLD=0.05
DRIFT_WINDOW_SIZE=100
